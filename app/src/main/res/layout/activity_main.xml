<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="12dp">

    <!-- 상단 툴바 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- 목록 버튼 (최소 48dp 보장) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="48dp"
            android:text="@string/btn_back"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:background="@drawable/btn_border"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="6dp" />

        <!-- 제목 입력 필드 (최소 130dp 확보 후 남은 공간 가변) -->
        <EditText
            android:id="@+id/etTitle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:minWidth="130dp"
            android:background="@drawable/btn_border"
            android:textCursorDrawable="@drawable/eink_cursor"
            android:hint="@string/et_title"
            android:textColorHint="#555555"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:singleLine="true" />

        <!-- 우측 버튼 3개 N등분 영역 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:layout_marginStart="6dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSaveLocal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:minWidth="48dp"
                android:paddingHorizontal="4dp"
                android:text="@string/btn_save_local"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:background="@drawable/btn_border" />

            <!-- 구글 버튼 숨겨두기  -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSaveGoogle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:minWidth="48dp"
                android:paddingHorizontal="4dp"
                android:layout_marginStart="4dp"
                android:text="@string/btn_save_google"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:background="@drawable/btn_border" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnExport"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:minWidth="48dp"
                android:paddingHorizontal="4dp"
                android:layout_marginStart="4dp"
                android:text="@string/btn_export"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:background="@drawable/btn_border" />
        </LinearLayout>
    </LinearLayout>

    <!-- 상단 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/black"
        android:layout_marginBottom="8dp" />

    <!-- 본문 작성 에디터 -->
    <EditText
        android:id="@+id/etContent"
        android:textCursorDrawable="@drawable/eink_cursor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:gravity="top|start"
        android:hint="@string/et_content"
        android:textColorHint="#777777"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:padding="8dp" />
</LinearLayout>